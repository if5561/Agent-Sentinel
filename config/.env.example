APP_NAME=Agent Sentinel
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=dev
LOG_LEVEL=INFO

OPENAI_API_KEY=your-litellm-master-key
CODEX_BASE_URL=
OPENAI_BASE_URL=http://127.0.0.1:4000/v1
OPENAI_MODEL=qwen-plus
OPENAI_TEMPERATURE=0
OPENAI_HTTP_TRUST_ENV=false

LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CACHE_TTL_SECONDS=300
LANGFUSE_LABEL=production
LANGFUSE_LINK_INITIAL_DELAY_MS=2000
LANGFUSE_LINK_POLL_INTERVAL_MS=2000
LANGFUSE_LINK_MAX_RETRIES=10
LANGFUSE_LINK_GENERATIONS=false
LANGFUSE_REMOTE_PROMPTS_ENABLED=true
LANGFUSE_PROMPT_DIR=config/prompts
LANGFUSE_TRACE_PROMPTS=true
LANGFUSE_TRACE_RAG=true
LANGFUSE_TRACE_TOOLS=true

AIOPS_SETTINGS_PATH=config/settings.yaml
AIOPS_WORKFLOW_CONFIG_PATH=config/workflow.yaml
AIOPS_LLM_MODELS=qwen-plus,qwen-turbo,qwen-max
AIOPS_MOCK_LLM_ENABLED=false
AIOPS_HUMAN_CONFIRM_ENABLED=true
AIOPS_HUMAN_CONFIRM_TIMEOUT_SECONDS=300
REDIS_URL=redis://localhost:6379/0

TOOLS_PROVIDER=mock
TOOLS_METRICS_ENABLED=true
TOOLS_LOGS_ENABLED=true
TOOLS_TOPOLOGY_ENABLED=true
MCP_ENABLED=false
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m agent_sentinel_mcp_server
MCP_TIMEOUT_SECONDS=20
MCP_SLS_TOOL=aliyun_sls_query_logs
MCP_PROMETHEUS_TOOL=prometheus_query_metrics
MCP_PROMETHEUS_BASE_URL=http://127.0.0.1:9090

RAG_PROVIDER=mock
RAG_FINAL_TOP_K=2
RAG_MMR_LAMBDA=0.55
RAG_STATIC_ENABLED=true
RAG_STATIC_COLLECTION=aiops_static_docs
RAG_STATIC_TOP_K=2
RAG_STATIC_WEIGHT=0.55
RAG_MESSAGE_ENABLED=true
RAG_MESSAGE_COLLECTION=aiops_message_history
RAG_MESSAGE_TOP_K=2
RAG_MESSAGE_WEIGHT=0.45
RAG_MESSAGE_DEFAULT_DAYS=30
RAG_CASE_CACHE_ENABLED=true
RAG_CASE_CACHE_THRESHOLD=0.85
RAG_CASE_CACHE_TOP_K=2
RAG_FEEDBACK_ENABLED=true

MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_MOCK_ENABLED=false

FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_EVENT_VERIFICATION_TOKEN=
FEISHU_EVENT_ENCRYPT_KEY=
FEISHU_BOT_NAME=Analysis Bot
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_ANALYZE_MENTION_ONLY=true
FEISHU_LONG_CONNECTION_ENABLED=false
FEISHU_MESSAGE_POLLING_ENABLED=true
FEISHU_MESSAGE_POLLING_INTERVAL_SECONDS=5
FEISHU_MESSAGE_POLLING_PAGE_SIZE=20

INTERACTIVE_TOPIC_ENABLED=true
INTERACTIVE_TOPIC_WAIT_SECONDS=5

FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
FEISHU_ALERT_ENABLED=true
FEISHU_ALERT_TITLE_PREFIX=Agent Sentinel

ALERT_ANALYSIS_ENABLED=true
ALERT_ANALYSIS_TITLE_PREFIX=Alert Analysis
ALERT_API_TOKEN=replace-with-a-strong-token
ALERT_DEDUP_WINDOW_SECONDS=60
ALERT_STORE_LIMIT=100
